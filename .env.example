BACKSEAT_DRIVER_API_HOST=127.0.0.1
BACKSEAT_DRIVER_API_PORT=8080
BACKSEAT_DRIVER_LOG_FORMAT=colored

BACKSEAT_DRIVER_UI_HOST=127.0.0.1
BACKSEAT_DRIVER_UI_PORT=8081

BACKSEAT_DRIVER_NUSCENES_DATAROOT=data/sets/nuscenes
BACKSEAT_DRIVER_NUSCENES_VERSION=v1.0-mini
BACKSEAT_DRIVER_CAMERA_CHANNEL=CAM_FRONT

BACKSEAT_DRIVER_VLM_BACKEND=huggingface
BACKSEAT_DRIVER_VLM_MODEL_NAME=Salesforce/blip-image-captioning-base

# Used when VLM_BACKEND=ollama (verbose, prompt-driven descriptions from a local Ollama server)
BACKSEAT_DRIVER_OLLAMA_MODEL_NAME=llava
BACKSEAT_DRIVER_OLLAMA_URL=http://localhost:11434
# Docker Compose containers can't use localhost for a host-run Ollama; this overrides it there only.
# BACKSEAT_DRIVER_COMPOSE_OLLAMA_URL=http://host.docker.internal:11434

# Used when VLM_BACKEND=anthropic (hosted Claude; billed per request)
BACKSEAT_DRIVER_ANTHROPIC_MODEL_NAME=claude-haiku-4-5-20251001
# BACKSEAT_DRIVER_ANTHROPIC_API_KEY=

BACKSEAT_DRIVER_OUTPUT_DIR=output

# monolith (default): /jobs runs on a thread inside the API, no broker or database needed.
# distributed: /jobs goes through RabbitMQ and Postgres to separate workers (docker compose sets this).
BACKSEAT_DRIVER_MODE=monolith
# The monolith keeps its jobs in this SQLite file so they survive a restart (empty: in memory only).
# BACKSEAT_DRIVER_JOBS_DB_PATH=output/jobs.db

# Distributed mode only (API + ingest/caption workers)
# BACKSEAT_DRIVER_RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# BACKSEAT_DRIVER_DATABASE_URL=postgresql+psycopg://backseat_driver:backseat_driver@localhost:5432/backseat_driver
# The dataset lives in an S3-compatible bucket that no worker mounts (no default; the workers refuse to start
# without it). Fill it once with `backseat-driver dataset upload`. These match the dev store `just infra` starts;
# boto3 reads the AWS_* credentials.
# BACKSEAT_DRIVER_DATASET_BUCKET=nuscenes
# BACKSEAT_DRIVER_S3_ENDPOINT_URL=http://localhost:9090
# AWS_ACCESS_KEY_ID=dev
# AWS_SECRET_ACCESS_KEY=dev
# AWS_DEFAULT_REGION=us-east-1
# BACKSEAT_DRIVER_CAPTION_PREFETCH=1
