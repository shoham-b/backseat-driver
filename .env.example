BACKSEAT_DRIVER_API_HOST=127.0.0.1
BACKSEAT_DRIVER_API_PORT=8080
BACKSEAT_DRIVER_LOG_FORMAT=colored

BACKSEAT_DRIVER_NUSCENES_DATAROOT=data/sets/nuscenes
BACKSEAT_DRIVER_NUSCENES_VERSION=v1.0-mini
BACKSEAT_DRIVER_CAMERA_CHANNEL=CAM_FRONT

BACKSEAT_DRIVER_VLM_BACKEND=huggingface
BACKSEAT_DRIVER_VLM_MODEL_NAME=Salesforce/blip-image-captioning-base

# Used when VLM_BACKEND=ollama (verbose, prompt-driven descriptions from a local Ollama server)
BACKSEAT_DRIVER_OLLAMA_MODEL_NAME=llava
BACKSEAT_DRIVER_OLLAMA_URL=http://localhost:11434

# Used when VLM_BACKEND=anthropic (hosted Claude; billed per request)
BACKSEAT_DRIVER_ANTHROPIC_MODEL_NAME=claude-haiku-4-5-20251001
# BACKSEAT_DRIVER_ANTHROPIC_API_KEY=

BACKSEAT_DRIVER_OUTPUT_PATH=output/scene_descriptions.json

# Distributed mode (API + ingest/caption workers)
BACKSEAT_DRIVER_RABBITMQ_URL=amqp://guest:guest@localhost:5672/
BACKSEAT_DRIVER_DATABASE_URL=postgresql+psycopg://backseat_driver:backseat_driver@localhost:5432/backseat_driver
BACKSEAT_DRIVER_CAPTION_PREFETCH=1
