VLM_SCENE_DESCRIPTION_API_HOST=127.0.0.1
VLM_SCENE_DESCRIPTION_API_PORT=8080
VLM_SCENE_DESCRIPTION_LOG_FORMAT=colored

VLM_SCENE_DESCRIPTION_NUSCENES_DATAROOT=data/sets/nuscenes
VLM_SCENE_DESCRIPTION_NUSCENES_VERSION=v1.0-mini
VLM_SCENE_DESCRIPTION_CAMERA_CHANNEL=CAM_FRONT

VLM_SCENE_DESCRIPTION_VLM_BACKEND=huggingface
VLM_SCENE_DESCRIPTION_VLM_MODEL_NAME=Salesforce/blip-image-captioning-base

# Used when VLM_BACKEND=ollama (verbose, prompt-driven descriptions from a local Ollama server)
VLM_SCENE_DESCRIPTION_OLLAMA_MODEL_NAME=llava
VLM_SCENE_DESCRIPTION_OLLAMA_URL=http://localhost:11434

# Used when VLM_BACKEND=anthropic (hosted Claude; billed per request)
VLM_SCENE_DESCRIPTION_ANTHROPIC_MODEL_NAME=claude-haiku-4-5-20251001
# VLM_SCENE_DESCRIPTION_ANTHROPIC_API_KEY=

VLM_SCENE_DESCRIPTION_OUTPUT_PATH=output/scene_descriptions.json

# Distributed mode (API + ingest/caption workers)
VLM_SCENE_DESCRIPTION_RABBITMQ_URL=amqp://guest:guest@localhost:5672/
VLM_SCENE_DESCRIPTION_DATABASE_URL=postgresql://vlmscene:vlmscene@localhost:5432/vlmscene
VLM_SCENE_DESCRIPTION_CAPTION_PREFETCH=1
