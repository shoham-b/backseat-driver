# syntax=docker/dockerfile:1
# Runs system + smoke tests against an already-running API container.
# Usage: docker compose --profile test up --abort-on-container-exit

ARG PYTHON_VERSION=3.12
FROM python:${PYTHON_VERSION}-slim

WORKDIR /app
COPY --from=ghcr.io/astral-sh/uv:0.8.17 /uv /usr/local/bin/uv
ENV UV_LINK_MODE=copy

# Install systemtest deps (no project source yet — layer cache friendly).
# Deliberately not the api/cli groups — these tests only speak HTTP to an
# already-running container, so they don't need torch/transformers locally.
RUN --mount=type=cache,target=/root/.cache/uv,id=uv-backseat-driver-systemtest \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --frozen --no-install-project --group systemtest

# Install project source so conftest.py imports resolve
COPY backseat_driver/ backseat_driver/
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv,id=uv-backseat-driver-systemtest \
    uv sync --frozen --group systemtest

COPY tests/conftest.py tests/
COPY tests/systemtests/ tests/systemtests/
COPY tests/smoketests/ tests/smoketests/

CMD [".venv/bin/pytest", "tests/systemtests", "tests/smoketests", "-v", "--tb=short"]
